{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "glue-doctor report, schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "scope", "summary", "findings", "suppressed"],
  "properties": {
    "schema_version": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "account_id"],
      "properties": {
        "region": { "type": "string" },
        "account_id": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs_audited", "findings", "exit_code"],
      "properties": {
        "jobs_audited": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["error", "warning", "info"],
          "properties": {
            "error": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "info": { "type": "integer", "minimum": 0 }
          }
        },
        "exit_code": { "type": "integer", "enum": [0, 1] }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "suppressed": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/finding" },
          { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string" } } }
        ]
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["check_id", "severity", "job", "message", "remediation", "evidence"],
      "properties": {
        "check_id": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "job": { "type": "string" },
        "message": { "type": "string" },
        "remediation": { "type": "string" },
        "evidence": { "type": "object" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
